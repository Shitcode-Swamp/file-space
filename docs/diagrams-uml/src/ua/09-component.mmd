%%{init: {'theme': 'neutral', 'themeVariables': {'fontSize': '15px'}, 'flowchart': {'subGraphTitleMargin': {'top': 10, 'bottom': 15}}}}%%
flowchart TB
    WebC["«component»<br/>React Web Client<br/>(браузер)"]
    SwiftC["«component»<br/>Swift Desktop Client"]

    subgraph EDGE["Домашній Ubuntu-сервер (Docker Compose)"]
        direction TB
        CFT["«component»<br/>cloudflared<br/>(Cloudflare Tunnel)"]
        Web["«component»<br/>web: nginx<br/>(статична збірка SPA)"]

        subgraph API["«component» api: Go API Server"]
            direction TB
            Handler["«component»<br/>Шар Handler<br/>(chi router, JWT middleware)"]
            Service["«component»<br/>Шар Service<br/>(бізнес-логіка)"]
            Repo["«component»<br/>Шар Repository<br/>(pgx/sqlx)"]
            IFileStorage(["Інтерфейс<br/>FileStorage"])
            Handler --> Service
            Service --> Repo
            Service --> IFileStorage
        end

        PG[("«component»<br/>PostgreSQL<br/>users, files, file_deletions")]
        Storage[("«component»<br/>Локальне файлове сховище<br/>(bind-mount каталог)")]
    end

    WebC -- "HTTPS / JSON REST" --> CFT
    SwiftC -- "HTTPS / JSON REST" --> CFT
    CFT -- "шлях: /api/*" --> Handler
    CFT -- "шлях: усе інше" --> Web
    Repo -- "SQL" --> PG
    Storage -. "реалізує" .-> IFileStorage
