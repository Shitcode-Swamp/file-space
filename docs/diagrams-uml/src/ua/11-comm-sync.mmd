%%{init: {'theme': 'neutral', 'themeVariables': {'fontSize': '15px'}}}%%
flowchart TB
    W["w : DirectoryWatcher<br/>(FSEvents, Swift)"]
    SC["sc : SyncViewModel<br/>(Swift-клієнт)"]
    H["h : SyncHandler<br/>(Go API)"]
    SS["ss : SyncService"]
    REP["rep : FileRepo"]
    DB[("db : PostgreSQL")]
    FSC["fsc : FolderScanner"]
    APPLY(["застосувати download /<br/>delete_local локально"])
    RECONCILE(["upload / re-upload /<br/>delete за локальним скануванням"])
    STATE(["lastSyncedVersion,<br/>entries := оновлено"])

    W -->|"1: подія зміни<br/>локальної теки"| SC
    SC -->|"2: POST /api/sync/diff<br/>{lastSyncedVersion}"| H
    H -->|"2.1: Diff(uploadedBy,<br/>sinceVersion)"| SS
    SS -->|"2.1.1: ListChangedSince(...)"| REP
    REP -->|"2.1.1.1: SELECT files,<br/>file_deletions"| DB
    DB -->|"2.1.1.2: рядки"| REP
    REP -->|"2.1.2: files, deletions,<br/>currentVersion"| SS
    SS -->|"2.2: { actions[], newVersion }"| H
    H -->|"3: 200 OK { actions[], newVersion }"| SC
    SC -->|"4: для кожної дії"| APPLY
    SC -->|"5: scan(folderPath)"| FSC
    FSC -->|"5.1: локальні позиції"| SC
    SC -->|"6: порівняти з відомими позиціями"| RECONCILE
    SC -->|"7: зберегти"| STATE
