%%{init: {'theme': 'neutral', 'themeVariables': {'fontSize': '18px'}, 'flowchart': {'nodeSpacing': 18, 'rankSpacing': 24, 'padding': 6}}}%%
flowchart TD
    Start(["Start"]) --> A1["Compute local manifest<br/>{name, size, mtime, sha256}"]
    A1 --> A2["Send POST /api/sync/diff<br/>(manifest + lastSyncedVersion)"]
    A2 --> A3["Server: compare manifest<br/>with files table and change log"]
    A3 --> D1{"For each file:<br/>type of discrepancy?"}

    D1 -->|"exists locally, not remotely"| B1["Action: upload"]
    D1 -->|"not local, exists remotely"| B2["Action: download"]
    D1 -->|"hash matches"| B3["Action: no-op"]
    D1 -->|"both changed"| B4["Action: conflict"]
    D1 -->|"deleted on server"| B5["Action: delete_local"]

    B1 --> C["Execute action on client"]
    B2 --> C
    B3 --> C
    B5 --> C

    B4 --> E["Show user<br/>conflict dialog"]
    E --> D2{"User choice"}
    D2 -->|"Keep local"| F1["Overwrite<br/>remote version"]
    D2 -->|"Keep remote"| F2["Overwrite<br/>local version"]
    D2 -->|"Keep both"| F3["Rename copy<br/>(conflict copy)"]
    F1 --> C
    F2 --> C
    F3 --> C

    C --> D3{"More files<br/>to process?"}
    D3 -->|"yes"| D1
    D3 -->|"no"| A4["Save newVersion<br/>as lastSyncedVersion"]
    A4 --> End(["End"])
