%%{init: {'theme': 'neutral', 'themeVariables': {'fontSize': '18px'}, 'flowchart': {'nodeSpacing': 18, 'rankSpacing': 24, 'padding': 6}}}%%
flowchart TD
    Start(["Start<br/>(FSEvents change or 45s poll)"]) --> A1["List remote files<br/>GET /api/files"]
    A1 --> A2["Send POST /api/sync/diff<br/>{lastSyncedVersion}"]
    A2 --> A3["Server: ListChangedSince(uploadedBy,<br/>lastSyncedVersion)"]
    A3 --> D1{"For each returned<br/>action"}

    D1 -->|"download"| B1["Fetch content,<br/>write to local folder,<br/>record known entry"]
    D1 -->|"delete_local"| B2["Remove local file,<br/>drop known entry"]
    B1 --> C1["Save lastSyncedVersion<br/>= newVersion"]
    B2 --> C1

    C1 --> A4["Scan local folder<br/>(name, size, sha256 per file)"]
    A4 --> D2{"For each local file"}

    D2 -->|"known, size/hash changed"| E1["Delete old remote copy,<br/>re-upload as new file"]
    D2 -->|"not known, no remote<br/>file with that name"| E2["Upload as new file"]
    D2 -->|"known, unchanged"| E3["No-op"]

    E1 --> F["Update known entry"]
    E2 --> F
    E3 --> F

    F --> D3{"Any known entry whose<br/>name is missing locally<br/>(and not just unreadable)?"}
    D3 -->|"yes"| G1["Delete remote copy,<br/>drop known entry"]
    D3 -->|"no"| H["Persist sync state to disk"]
    G1 --> H
    H --> End(["End"])
