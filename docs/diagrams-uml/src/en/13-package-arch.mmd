flowchart TB
    subgraph FE["«package» frontend (React + TS)"]
        direction TB
        FEUi["ui / components<br/>(App, columns, FilePreviewModal,<br/>SettingsModal, auth/LoginPage)"]
        FEState["api client<br/>(TanStack Query, TanStack Table,<br/>TanStack Virtual)"]
    end

    subgraph DE["«package» desktop (Swift)"]
