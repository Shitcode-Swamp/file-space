        BEHandler -. "uses" .-> BESupport
        BEService -. "uses" .-> BESupport
        BERepo -. "uses" .-> BESupport
    end

    subgraph MIG["«package» migrations<br/>(golang-migrate SQL)"]
    end

    DEApi --> DEUi
    DEApi --> DESync

    FEState -. "HTTPS / JSON REST" .-> BEHandler
