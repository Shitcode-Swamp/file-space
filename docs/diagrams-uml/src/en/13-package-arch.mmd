    end

    subgraph BE["«package» backend (Go module)"]
        direction TB
        subgraph BEHandler["«package» handler<br/>(cmd/api, internal/handler)"]
        end
        subgraph BEService["«package» service<br/>(internal/service)"]
        end
        subgraph BERepo["«package» repo<br/>(internal/repo)"]
        end
        subgraph BEStorage["«package» storage<br/>(internal/storage, FileStorage)"]
        end
        subgraph BESupport["«package» domain, db, config,<br/>authctx (internal/*)"]
