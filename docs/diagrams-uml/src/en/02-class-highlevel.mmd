%%{init: {'theme': 'neutral', 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    class User {
        +int64 id
        +string username
        +string passwordHash
    }

    class File {
        +int64 id
        +string name
        +string storageKey
        +string extension
        +int64 size
        +datetime createdAt
        +datetime modifiedAt
        +int64 uploadedBy
        +int64 editedBy
        +int64 version
    }

    class Deletion {
        +int64 fileId
        +string name
        +string storageKey
        +int64 version
        +datetime deletedAt
    }

    class FileService {
        +List(params) File[]
        +Get(uploadedBy, id) File
        +Content(uploadedBy, id) File, Reader
        +Download(uploadedBy, id) File, Reader
        +Create(uploadedBy, filename, reader) File
        +Delete(uploadedBy, id) void
        +InitiateUpload(uploadedBy, filename, size) uploadId
        +UploadChunk(uploadId, index, reader) void
        +CompleteUpload(uploadId) File
    }

    class FileRepo {
        <<interface>>
        +List(params) File[], hasMore
        +GetByID(uploadedBy, id) File
        +Create(file) File
        +Delete(uploadedBy, id) void
        +ListChangedSince(uploadedBy, sinceVersion) File[], Deletion[], version
    }

    class FileStorage {
        <<interface>>
        +Save(key, reader) error
        +Open(key) ReadCloser
        +Delete(key) error
    }

    class LocalFileStorage {
        +root string
    }

    class AuthService {
        +Register(username, password) User
        +Login(username, password) accessToken, refreshToken
        +Refresh(refreshToken) accessToken
    }

    class SyncService {
        +Diff(uploadedBy, sinceVersion) SyncAction[], newVersion
    }

    User "1" --> "0..*" File : uploadedBy / editedBy
    FileService --> FileRepo : uses
    FileService --> FileStorage : uses
    AuthService --> User : manages
    LocalFileStorage ..|> FileStorage : implements
    SyncService --> FileRepo : uses (ListChangedSince)
    FileRepo --> File : persists
    FileRepo --> Deletion : persists
