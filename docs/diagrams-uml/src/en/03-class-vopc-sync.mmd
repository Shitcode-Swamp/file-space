%%{init: {'theme': 'neutral', 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    class SyncPanelView {
        <<boundary>>
        +chooseFolder()
        +start()
        +stop()
    }

    class DirectoryWatcher {
        <<boundary>>
        +onLocalChangeDetected()
    }

    class SyncViewModel {
        <<control>>
        +reconcile()
        +scheduleReconcile()
    }

    class SyncHandler {
        <<control>>
        +diff(request) response
    }

    class SyncService {
        <<control>>
        +Diff(uploadedBy, sinceVersion) actions, newVersion
    }

    class FolderScanner {
        <<control>>
        +scan(folderPath) ScanResult
    }

    class SyncState {
        <<entity>>
        +string folderPath
        +int64 lastSyncedVersion
        +Map~name,SyncedFileEntry~ entries
    }

    class SyncedFileEntry {
        <<entity>>
        +int64 remoteID
        +int64 size
        +double mtime
        +string sha256
    }

    class File {
        <<entity>>
        +int64 id
        +string name
        +int64 version
    }

    class Deletion {
        <<entity>>
        +int64 fileId
        +string name
        +int64 version
    }

    DirectoryWatcher --> SyncViewModel : local change event<br/>(debounced)
    SyncViewModel --> SyncState : reads/writes<br/>lastSyncedVersion, entries
    SyncViewModel --> SyncHandler : POST /api/sync/diff<br/>{lastSyncedVersion}
    SyncHandler --> SyncService : Diff(uploadedBy, sinceVersion)
    SyncService --> File : ListChangedSince
    SyncService --> Deletion : ListChangedSince
    SyncViewModel --> FolderScanner : scan local folder
    FolderScanner --> SyncedFileEntry : builds
    SyncViewModel --> SyncedFileEntry : compares local vs. known<br/>(size/sha256) to decide<br/>upload / re-upload / delete
    SyncPanelView --> SyncViewModel : start / stop / chooseFolder
