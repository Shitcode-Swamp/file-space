%%{init: {'theme': 'neutral', 'themeVariables': {'fontSize': '15px'}}}%%
classDiagram
    class FolderWatcherUI {
        <<boundary>>
        +onLocalChangeDetected()
    }

    class SyncNowButtonUI {
        <<boundary>>
    }

    class ConflictDialogUI {
        <<boundary>>
        +askUserResolution(file) Resolution
    }

    class SyncController {
        <<control>>
        +runSyncCycle()
        +buildLocalManifest() ManifestEntry[]
    }

    class SyncDiffService {
        <<control>>
        +computeDiff(manifest, lastSyncedVersion) SyncResult
    }

    class ConflictResolver {
        <<control>>
        +resolve(file, resolution)
    }

    class ManifestEntry {
        <<entity>>
        +string name
        +int size
        +datetime mtime
        +string sha256
    }

    class SyncCursor {
        <<entity>>
        +int lastSyncedVersion
    }

    class File {
        <<entity>>
        +UUID id
        +string name
        +string sha256
        +int version
    }

    class ChangeLogEntry {
        <<entity>>
        +UUID fileId
        +string changeType
        +int version
    }

    FolderWatcherUI --> SyncController : FSEvents event
    SyncNowButtonUI --> SyncController : manual trigger
    SyncController --> ManifestEntry : builds
    SyncController --> SyncCursor : reads lastSyncedVersion
    SyncController --> SyncDiffService : POST /api/sync/diff
    SyncDiffService --> File : compares with
    SyncDiffService --> ChangeLogEntry : reads changes from
    SyncDiffService --> ManifestEntry : receives from client
    SyncController --> ConflictResolver : action = conflict
    ConflictResolver --> ConflictDialogUI : shows choice
    ConflictResolver --> File : keep local / remote / both
    SyncController --> SyncCursor : updates newVersion
