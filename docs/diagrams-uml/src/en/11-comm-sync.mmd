%%{init: {'theme': 'neutral', 'themeVariables': {'fontSize': '15px'}}}%%
flowchart TB
    W["w : DirectoryWatcher<br/>(FSEvents, Swift)"]
    SC["sc : SyncViewModel<br/>(Swift client)"]
    H["h : SyncHandler<br/>(Go API)"]
    SS["ss : SyncService"]
    REP["rep : FileRepo"]
    DB[("db : PostgreSQL")]
    FSC["fsc : FolderScanner"]
    APPLY(["apply download /<br/>delete_local locally"])
    RECONCILE(["upload / re-upload /<br/>delete based on local scan"])
    STATE(["lastSyncedVersion,<br/>entries := updated"])

    W -->|"1: local folder<br/>change event"| SC
    SC -->|"2: POST /api/sync/diff<br/>{lastSyncedVersion}"| H
    H -->|"2.1: Diff(uploadedBy,<br/>sinceVersion)"| SS
    SS -->|"2.1.1: ListChangedSince(...)"| REP
    REP -->|"2.1.1.1: SELECT files,<br/>file_deletions"| DB
    DB -->|"2.1.1.2: rows"| REP
    REP -->|"2.1.2: files, deletions,<br/>currentVersion"| SS
    SS -->|"2.2: { actions[], newVersion }"| H
    H -->|"3: 200 OK { actions[], newVersion }"| SC
    SC -->|"4: for each action"| APPLY
    SC -->|"5: scan(folderPath)"| FSC
    FSC -->|"5.1: local entries"| SC
    SC -->|"6: compare vs. known entries"| RECONCILE
    SC -->|"7: persist"| STATE
