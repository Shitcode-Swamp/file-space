# Copy this file to .env (gitignored) and fill in real values.
# Referenced by deploy/docker-compose.yml and the Go backend.

# Postgres connection string used by the Go API (host "db" matches the
# docker-compose service name; keep user/password in sync with the
# POSTGRES_* vars below).
DATABASE_URL=postgres://filespace:changeme@db:5432/filespace?sslmode=disable

# Secret used to sign/verify JWT access tokens. Use a long random string
# (e.g. `openssl rand -base64 48`).
JWT_SECRET=changeme-generate-a-long-random-secret

# Directory (inside the api container) where uploaded files are stored;
# bind-mounted from ../storage on the host. See REQUIREMENTS.md §5.5.
STORAGE_DIR=/data/storage

# Origin allowed to make cross-origin requests to the API (the frontend's
# dev/prod origin). Optional; defaults to "http://localhost:5173" (the Vite
# dev server) when unset.
#CORS_ALLOWED_ORIGIN=http://localhost:5173

# Postgres database name and user created in the db container on first run.
POSTGRES_DB=filespace
POSTGRES_USER=filespace

# Password for the Postgres user above; must match the credentials embedded
# in DATABASE_URL.
POSTGRES_PASSWORD=changeme

# Token from `cloudflared tunnel create filespace` (or the Zero Trust
# dashboard) that lets the cloudflared container run the tunnel without a
# local credentials file. Keep this secret.
TUNNEL_TOKEN=changeme-tunnel-token
